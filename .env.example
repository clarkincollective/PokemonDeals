# Copy this file to .env.local and fill in your real values.
# .env.local is ignored by git, so your secrets never get committed.

# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From Supabase: Project Settings > API (the "service_role" secret key)
# NEVER put this in NEXT_PUBLIC_ - it must stay server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# From JustTCG: your account's API key
JUSTTCG_API_KEY=your-justtcg-api-key

# From the eBay Developer Program: your app's keys (developer.ebay.com > My Account > Keys)
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret

# From eBay Partner Network, once approved: turns eBay links into
# commission-earning affiliate links. Leave blank until then - the site
# still works with plain links in the meantime.
EBAY_CAMPAIGN_ID=

# From TCGPlayer's affiliate program (via impact.com), once approved.
# Leave blank until then.
TCGPLAYER_AFFILIATE_ID=

# From pokemonpricetracker.com: powers graded-card (PSA/CGC/BGS/etc) sold
# pricing. Needs their Business tier for commercial/public use.
POKEMONPRICETRACKER_API_KEY=your-pokemonpricetracker-api-key

# A random string you make up yourself - protects the scheduled refresh
# endpoint so only your cron job (not random visitors) can trigger it.
CRON_SECRET=make-up-a-long-random-string-here

# eBay's account-deletion webhook verification (developer.ebay.com > Alerts
# & Notifications). ENDPOINT must exactly match what you paste into eBay's
# dashboard for this notification.
EBAY_VERIFICATION_TOKEN=make-up-another-long-random-string
EBAY_ACCOUNT_DELETION_ENDPOINT=https://your-deployed-domain/api/ebay/account-deletion

# Phase 13C.6.0 - LOCAL/ADMIN ONLY. Read credentials for
# scripts/reportHomepageConversion.mjs, a read-only aggregate PostHog
# report - not used by the website itself, never sent to the browser.
#   1. PostHog -> Settings -> Personal API Keys -> create one with project
#      read access (no write scopes needed).
#   2. PostHog -> Project Settings -> Project ID (the numeric id - this is
#      NOT the phc_... key above, which is the browser ingest key).
#   3. Run: node scripts/reportHomepageConversion.mjs
#   4. Never commit these, never paste them into a chat session, never
#      prefix them with NEXT_PUBLIC_.
# The report defaults to the clean measurement window that began
# 2026-09-04T20:18:17Z (Phase 13C.5.1 deploy) - do not use data from
# before that instant for a product decision; pass --from to override.
POSTHOG_PERSONAL_API_KEY=your-posthog-personal-api-key
POSTHOG_PROJECT_ID=your-posthog-numeric-project-id
