# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Phase 13D.4 - local-only social content preview output (PNGs, captions,
# payload JSON). Never committed - this is dev/review scratch output, not
# a build artifact or published content.
/.social-preview/

# Phase 13E.3 - OpenAI brand-asset STORAGE POLICY (docs/social-asset-library.md SS22).
# assets/social/generated/ is the working area: raw OpenAI PNG output pending
# human review. Those PNGs are scratch and are NOT committed - only the
# manifest (social-assets.json) is tracked. `social:assets approve` copies
# a reviewed PNG into assets/social/approved/ (which IS committed) and
# repoints the manifest at it, so the repo only carries approved assets.
assets/social/generated/**/*.png
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Impeccable design skill: the reference docs + scripts + hook config ARE
# committed (reproducible design work), but the ~15 MB self-downloading
# platform binary and the regenerable font index are not - they re-hydrate
# on first run.
.claude/skills/impeccable/scripts/bin/
.claude/skills/impeccable/scripts/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
scripts/_*.js
.secrets/
